{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orynquix.dev/schemas/bootstrap.schema.json",
  "title": "Orynquix bootstrap state",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "updated_at", "rootfs_created_by_orynquix", "container_name", "image_reference"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["running", "interrupted", "complete"] },
    "updated_at": { "type": "string", "format": "date-time" },
    "rootfs_created_by_orynquix": { "type": "boolean" },
    "container_name": { "const": "orynquix-debian" },
    "image_reference": { "const": "debian:stable" },
    "last_error": { "type": "string" }
  }
}
