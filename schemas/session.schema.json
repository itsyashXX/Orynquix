{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orynquix.dev/schemas/session.schema.json",
  "title": "Orynquix session state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "state", "updated_at", "processes", "services", "diagnostic_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["stopped", "starting", "running", "degraded", "failed", "repairing", "stopping"]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "diagnostic_id": { "type": ["string", "null"] },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pid", "process_group", "started_at", "start_ticks", "cmdline_sha256", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "pid": { "type": "integer", "minimum": 1 },
          "process_group": { "type": "integer", "minimum": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "start_ticks": { "type": "integer", "minimum": 0 },
          "cmdline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "health", "message", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "health": { "enum": ["pass", "warn", "fail", "skip"] },
          "message": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}

